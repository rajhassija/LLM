<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.com/ontology/"
         xmlns="http://example.com/ontology/">

<owl:Ontology rdf:about="http://example.com/ontology"/>

<owl:ObjectProperty rdf:about="ordered_by">
  <rdfs:domain rdf:resource="Order"/>
  <rdfs:range rdf:resource="Customer"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="contains_product">
  <rdfs:domain rdf:resource="Order"/>
  <rdfs:range rdf:resource="Product"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="has_reqid">
  <rdfs:domain rdf:resource="requestransaction"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="requestoutcome"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_reqamount">
  <rdfs:domain rdf:resource="requestransaction"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_reqdisttype">
  <rdfs:domain rdf:resource="requestransaction"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_addresschangedaysoutcome">
  <rdfs:domain rdf:resource="requestoutcome"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_id">
  <rdfs:domain rdf:resource="Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="plan"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_name">
  <rdfs:domain rdf:resource="Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="plan"/>
  <rdfs:domain rdf:resource="Customer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_price">
  <rdfs:domain rdf:resource="Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_category">
  <rdfs:domain rdf:resource="Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_order_id">
  <rdfs:domain rdf:resource="Order"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_product_id">
  <rdfs:domain rdf:resource="Order"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_quantity">
  <rdfs:domain rdf:resource="Order"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_total_price">
  <rdfs:domain rdf:resource="Order"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_customer_id">
  <rdfs:domain rdf:resource="Customer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_email">
  <rdfs:domain rdf:resource="Customer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_loyalty_points">
  <rdfs:domain rdf:resource="Customer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_addresschangedbyemployer">
  <rdfs:domain rdf:resource="Customer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="has_addresschangedays">
  <rdfs:domain rdf:resource="Customer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="Product">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="plan">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="feature">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="Order">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="Customer">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="requestransaction">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="requestoutcome">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>


</rdf:RDF>
